APP_ENV=testing
# APP_KEY is injected by phpunit.xml <env name="APP_KEY"> — do NOT add it here (ADR-S3: no secrets in tracked files)

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
BCRYPT_ROUNDS=4
